		<string>This app requires access to the photo library to select profile photos.</string>
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>This app needs access to location to show your position on the map and calculate real-time routes.</string>
		<key>NSLocationAlwaysUsageDescription</key>
		<string>This app needs background location access to provide real-time navigation and route updates even when the app is in the background.</string>
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>This app needs location access to show your position on the map and provide real-time navigation updates.</string>
		<key>UIBackgroundModes</key>
		<array>
			<string>location</string>
		</array>
		<key>UIStatusBarHidden</key>
		<false/>
